---
import '../styles/global.css';
const { title = 'Dairy Velvet', description, noindex = false } = Astro.props;
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, Astro.site);
const ogImage = new URL('/images/og-image.jpg', Astro.site);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dairy Velvet" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dairy Velvet Vanilla, Chocolate, and Dulce de Leche farmer's cheese snacks" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    {import.meta.env.PROD && (
      <>
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-QEHVXBTJNK"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ window.dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', 'G-QEHVXBTJNK');
        </script>
      </>
    )}
    <style is:global>
      body {
        font-family: 'Inter', sans-serif;
        background-color: #fdfaf6;
        color: #1c1008;
      }
      .dv-serif {
        font-family: 'Lora', serif;
      }
    </style>
  </head>
  <body>
    <div class="sticky top-0 z-50">
      <!-- Header -->
      <header class="bg-white" style="border-bottom: 1px solid #e8d5b7;">
        <div class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-6 py-4">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3">
          <img src="/images/logo.png" alt="Dairy Velvet" class="h-10 w-10 rounded-full object-cover" />
          <span class="dv-serif font-semibold text-lg hidden sm:block" style="color: #3d2314;">Dairy Velvet</span>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden md:flex items-center gap-8">
          <a href="/where-to-buy" class="text-sm font-medium hover:opacity-60 transition-opacity" style="color: #1c1008;">Where to Buy</a>
          <a href="/nutrition" class="text-sm font-medium hover:opacity-60 transition-opacity" style="color: #1c1008;">Nutrition</a>
          <a href="/contact" class="text-sm font-medium hover:opacity-60 transition-opacity" style="color: #1c1008;">Contact</a>
          <a href="https://dairyvelvet.square.site" target="_blank" class="text-sm font-semibold px-4 py-2 rounded-full transition-opacity hover:opacity-80" style="background-color: #3d2314; color: #fdfaf6;">Order Now</a>
        </nav>

        <!-- Right side: Order Now (mobile) + social icons (always visible) + hamburger (mobile only) -->
        <div class="flex items-center gap-3">
          <a href="https://dairyvelvet.square.site" target="_blank" class="md:hidden whitespace-nowrap text-sm font-semibold px-4 py-2 rounded-full transition-opacity hover:opacity-80" style="background-color: #3d2314; color: #fdfaf6;">Order Now</a>
          <div class="flex items-center gap-1">
            <a target="_blank" href="https://www.facebook.com/profile.php?id=61580376261342" aria-label="Facebook" class="opacity-60 hover:opacity-100 transition-opacity p-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 md:h-5 md:w-5" viewBox="0 0 24 24" fill="#3d2314">
                <path d="M22 12c0-5.522-4.477-10-10-10S2 6.478 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987H7.898v-2.89h2.54V9.797c0-2.507 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562v1.875h2.773l-.443 2.89h-2.33v6.987C18.343 21.128 22 16.991 22 12z" />
              </svg>
            </a>
            <a target="_blank" href="https://www.instagram.com/dairy_velvet/" aria-label="Instagram" class="opacity-60 hover:opacity-100 transition-opacity p-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 md:h-5 md:w-5" viewBox="0 0 24 24" fill="#3d2314">
                <path d="M7 2C4.2 2 2 4.2 2 7v10c0 2.8 2.2 5 5 5h10c2.8 0 5-2.2 5-5V7c0-2.8-2.2-5-5-5H7zm10 2c1.7 0 3 1.3 3 3v10c0 1.7-1.3 3-3 3H7c-1.7 0-3-1.3-3-3V7c0-1.7 1.3-3 3-3h10zM12 7a5 5 0 100 10 5 5 0 000-10zm0 2a3 3 0 110 6 3 3 0 010-6zm4.8-3a1.2 1.2 0 11-2.4 0 1.2 1.2 0 012.4 0z" />
              </svg>
            </a>
          </div>

          <!-- Hamburger button (mobile only) -->
          <button
            id="menu-btn"
            aria-controls="mobile-menu"
            class="md:hidden flex flex-col justify-center items-center w-8 h-8 gap-1.5"
            aria-label="Toggle menu"
            aria-expanded="false">
            <span class="menu-bar block w-5 h-0.5 transition-all duration-200" style="background-color: #3d2314;"></span>
            <span class="menu-bar block w-5 h-0.5 transition-all duration-200" style="background-color: #3d2314;"></span>
            <span class="menu-bar block w-5 h-0.5 transition-all duration-200" style="background-color: #3d2314;"></span>
          </button>
        </div>
      </div>

      <!-- Mobile nav drawer -->
      <nav
        id="mobile-menu"
        class="hidden md:hidden px-6 pb-5 pt-2 flex flex-col gap-4"
        style="border-top: 1px solid #e8d5b7;">
        <a href="/where-to-buy" class="text-sm font-medium py-1" style="color: #1c1008;">Where to Buy</a>
        <a href="/nutrition" class="text-sm font-medium py-1" style="color: #1c1008;">Nutrition</a>
        <a href="/contact" class="text-sm font-medium py-1" style="color: #1c1008;">Contact</a>
        <a href="https://dairyvelvet.square.site" target="_blank" class="text-sm font-semibold px-4 py-2 rounded-full text-center transition-opacity hover:opacity-80" style="background-color: #3d2314; color: #fdfaf6;">Order Now</a>
      </nav>
      </header>

      <!-- Promo Banner -->
      <div id="promo-banner" class="relative" style="background-color: #3d2314;">
        <a
          href="https://dairy-velvet-survey.netlify.app/join"
          target="_blank"
          rel="noopener"
          class="flex items-center justify-center gap-2 px-10 py-2.5 text-center text-xs sm:text-sm font-medium hover:opacity-90 transition-opacity"
          style="color: #fdfaf6;">
          <span>Join our email list for 10% off at the market and online</span>
          <span class="font-semibold underline underline-offset-2 whitespace-nowrap">Join Now →</span>
        </a>
        <button
          id="promo-banner-close"
          aria-label="Dismiss banner"
          class="absolute right-2 top-1/2 -translate-y-1/2 p-1.5 opacity-70 hover:opacity-100 transition-opacity"
          style="color: #fdfaf6;">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <script is:inline>
        (function () {
          var KEY = 'dv-promo-banner-dismissed';
          var banner = document.getElementById('promo-banner');
          if (!banner) return;
          if (localStorage.getItem(KEY)) {
            banner.style.display = 'none';
            return;
          }
          var closeBtn = document.getElementById('promo-banner-close');
          closeBtn && closeBtn.addEventListener('click', function () {
            localStorage.setItem(KEY, '1');
            banner.style.display = 'none';
          });
        })();
      </script>
    </div>

    <script>
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-menu');
      const setOpen = (open: boolean) => {
        if (!btn || !menu) return;
        menu.classList.toggle('hidden', !open);
        btn.setAttribute('aria-expanded', String(open));
        const bars = btn.querySelectorAll<HTMLElement>('.menu-bar');
        if (open) {
          bars[0].style.transform = 'translateY(8px) rotate(45deg)';
          bars[1].style.opacity = '0';
          bars[2].style.transform = 'translateY(-8px) rotate(-45deg)';
        } else {
          bars[0].style.transform = '';
          bars[1].style.opacity = '';
          bars[2].style.transform = '';
        }
      };
      const isOpen = () => btn?.getAttribute('aria-expanded') === 'true';

      btn?.addEventListener('click', () => setOpen(!isOpen()));
      // Close after a link is chosen (Order Now opens a new tab, so the page stays behind it)
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen()) {
          setOpen(false);
          btn?.focus();
        }
      });
    </script>

    <main><slot /></main>

    <footer class="py-8 px-4 text-sm text-center" style="border-top: 1px solid #e8d5b7; color: #7a5c3e;">
      <nav aria-label="Footer" class="flex flex-wrap justify-center gap-x-6 gap-y-2 mb-4">
        <a href="/" class="hover:underline">Home</a>
        <a href="/where-to-buy/" class="hover:underline">Where to Buy</a>
        <a href="/nutrition/" class="hover:underline">Nutrition</a>
        <a href="/contact/" class="hover:underline">Contact</a>
        <a href="https://dairyvelvet.square.site" target="_blank" class="hover:underline">Order Now</a>
        <a href="https://www.instagram.com/dairy_velvet/" target="_blank" class="hover:underline">Instagram</a>
        <a href="https://www.facebook.com/profile.php?id=61580376261342" target="_blank" class="hover:underline">Facebook</a>
      </nav>
      <p>© {new Date().getFullYear()} Dairy Velvet · Lansdale, PA</p>
    </footer>
  </body>
</html>
