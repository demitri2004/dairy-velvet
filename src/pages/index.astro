---
import LayoutNew from '../layouts/LayoutNew.astro';

// Business details for search engines. Only facts already shown on the site:
// no street address (home-based), no hours (market days vary), no prices.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Dairy Velvet',
  url: 'https://dairyvelvet.com/',
  logo: 'https://dairyvelvet.com/images/logo.png',
  image: 'https://dairyvelvet.com/images/og-image.jpg',
  description:
    "Small-batch chocolate-coated farmer's cheese bars inspired by Eastern European syrok, made with Pennsylvania dairy.",
  telephone: '+1-267-219-8251',
  email: 'team@dairyvelvet.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lansdale',
    addressRegion: 'PA',
    addressCountry: 'US',
  },
  sameAs: ['https://www.instagram.com/dairy_velvet/', 'https://www.facebook.com/profile.php?id=61580376261342'],
};
---

<LayoutNew
  title="Chocolate-Covered Farmer's Cheese Snacks | Dairy Velvet"
  description="Small-batch chocolate-coated farmer's cheese bars inspired by Eastern European syrok, made with Pennsylvania dairy. Find us at local markets or order for pickup and delivery."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(organization)} />
  <!-- Hero -->
  <section class="flex flex-col lg:flex-row" style="min-height: 520px;">
    <div class="lg:w-3/5 h-72 lg:h-auto overflow-hidden">
      <img src="/images/gallery7.jpg" alt="Dairy Velvet bars cut open to show the creamy farmer's cheese center" class="w-full h-full object-cover" />
    </div>
    <div class="lg:w-2/5 flex flex-col justify-center px-10 py-16" style="background-color: #EAD7BF;">
      <p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color: #BE8D5A;">Dairy Velvet · Small Batch · Pennsylvania</p>
      <h1 class="dv-serif font-bold leading-tight text-4xl lg:text-5xl" style="color: #1A0E07;">Chocolate-Coated Farmer's Cheese Bars</h1>
      <p class="mt-5 text-base leading-relaxed" style="color: #5C3A20; max-width: 360px;">
        Silky chocolate over a creamy center made with protein-rich farmer's cheese. Inspired by the Eastern European syrok we grew up with.
      </p>
    </div>
  </section>

  <!-- Product -->
  <section class="py-16 px-4" style="background-color: #F8F3EC;">
    <div class="max-w-5xl mx-auto flex flex-col lg:flex-row items-center gap-12">
      <div class="lg:w-1/2">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: #BE8D5A;">Our Product</p>
        <h2 class="dv-serif font-bold text-4xl leading-tight mb-6" style="color: #1A0E07;">Inspired by tradition,<br/>made for today</h2>
        <p class="text-base leading-relaxed mb-4" style="color: #5C3A20;">
          Dairy Velvet is a creamy farmer's cheese center wrapped in a delicate layer of silky chocolate. Made in small batches with Pennsylvania dairy and simple, wholesome ingredients - an indulgent treat with up to 5g of protein in every bar.
        </p>
        <p class="text-base leading-relaxed" style="color: #5C3A20;">
          Inspired by the beloved Eastern European treat Syrok, we've refined the recipe for today. A treat for kids and grown-ups alike.
        </p>
      </div>
      <div class="lg:w-1/2 rounded-2xl overflow-hidden shadow-md">
        <img src="/images/products-three-flavors.jpg" alt="Dairy Velvet Vanilla, Chocolate, and Dulce de Leche" class="w-full aspect-[3/2] object-cover" />
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-12 px-4" style="background-color: #EAD7BF;">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="bg-white rounded-2xl p-8 shadow-sm" style="border: 1px solid #D4BFA0;">
        <div class="w-10 h-10 rounded-full flex items-center justify-center mb-5" style="background-color: #EAD7BF;">
          <svg class="w-5 h-5" fill="none" stroke="#BE8D5A" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
        </div>
        <h3 class="dv-serif font-semibold text-lg mb-2" style="color: #1A0E07;">Wholesome Ingredients</h3>
        <p class="text-sm leading-relaxed" style="color: #5C3A20;">Made with fresh Pennsylvania dairy and simple ingredients.</p>
      </div>
      <div class="bg-white rounded-2xl p-8 shadow-sm" style="border: 1px solid #D4BFA0;">
        <div class="w-10 h-10 rounded-full flex items-center justify-center mb-5" style="background-color: #EAD7BF;">
          <svg class="w-5 h-5" fill="none" stroke="#BE8D5A" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.05 4.575a1.575 1.575 0 1 0-3.15 0v3m3.15-3v-1.5a1.575 1.575 0 0 1 3.15 0v1.5m-3.15 0 .075 5.925m3.075.75V4.575m0 0a1.575 1.575 0 0 1 3.15 0V15M6.9 7.575a1.575 1.575 0 1 0-3.15 0v8.175a6.75 6.75 0 0 0 6.75 6.75h2.018a5.25 5.25 0 0 0 3.712-1.538l1.732-1.732a5.25 5.25 0 0 0 1.538-3.712l.003-2.024a.668.668 0 0 1 .198-.471 1.575 1.575 0 1 0-2.228-2.228 3.818 3.818 0 0 0-1.12 2.687M6.9 7.575V12m6.27 4.318A4.49 4.49 0 0 1 16.35 15m.002 0h-.002"/>
          </svg>
        </div>
        <h3 class="dv-serif font-semibold text-lg mb-2" style="color: #1A0E07;">Handmade in Small Batches</h3>
        <p class="text-sm leading-relaxed" style="color: #5C3A20;">Every bar is dipped and cut by hand.</p>
      </div>
      <div class="bg-white rounded-2xl p-8 shadow-sm" style="border: 1px solid #D4BFA0;">
        <div class="w-10 h-10 rounded-full flex items-center justify-center mb-5" style="background-color: #EAD7BF;">
          <svg class="w-5 h-5" fill="none" stroke="#BE8D5A" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
          </svg>
        </div>
        <h3 class="dv-serif font-semibold text-lg mb-2" style="color: #1A0E07;">Protein in Every Bar</h3>
        <p class="text-sm leading-relaxed" style="color: #5C3A20;">Up to 5g of protein per bar from real farmer's cheese.</p>
      </div>
    </div>
  </section>

  <!-- Flavors -->
  <section class="py-16 px-4" style="background-color: #F8F3EC;">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest mb-2" style="color: #BE8D5A;">Our Flavors</p>
        <h2 class="dv-serif font-bold text-3xl" style="color: #1A0E07;">Choose Your Favorite</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm" style="border: 1px solid #D4BFA0;">
          <img src="/images/product_dulce-de-leche.jpg" alt="Dairy Velvet Dulce de Leche bar" loading="lazy" class="w-full h-56 object-cover" />
          <div class="p-6">
            <p class="text-xs font-semibold uppercase tracking-widest mb-1" style="color: #BE8D5A;">Signature Flavor</p>
            <h3 class="dv-serif font-semibold text-xl mb-2" style="color: #1A0E07;">Dulce de Leche</h3>
            <p class="text-sm leading-relaxed mb-3" style="color: #5C3A20;">Creamy farmer's cheese swirled with rich dulce de leche, wrapped in silky chocolate. Our most requested flavor.</p>
            <a href="/nutrition/#dulce-de-leche" class="text-xs font-semibold uppercase tracking-widest hover:underline" style="color: #BE8D5A;">Nutrition Facts →</a>
          </div>
        </div>
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm" style="border: 1px solid #D4BFA0;">
          <img src="/images/product_vanilla.jpg" alt="Dairy Velvet Vanilla bar" loading="lazy" class="w-full h-56 object-cover" />
          <div class="p-6">
            <h3 class="dv-serif font-semibold text-xl mb-2" style="color: #1A0E07;">Vanilla</h3>
            <p class="text-sm leading-relaxed mb-3" style="color: #5C3A20;">Classic vanilla farmer's cheese in a thin layer of chocolate. Simple and creamy.</p>
            <a href="/nutrition/#vanilla" class="text-xs font-semibold uppercase tracking-widest hover:underline" style="color: #BE8D5A;">Nutrition Facts →</a>
          </div>
        </div>
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm" style="border: 1px solid #D4BFA0;">
          <img src="/images/product_chocolate.jpg" alt="Dairy Velvet Chocolate bar" loading="lazy" class="w-full h-56 object-cover" />
          <div class="p-6">
            <h3 class="dv-serif font-semibold text-xl mb-2" style="color: #1A0E07;">Chocolate</h3>
            <p class="text-sm leading-relaxed mb-3" style="color: #5C3A20;">Chocolate farmer's cheese inside a chocolate coating, for when you want double chocolate.</p>
            <a href="/nutrition/#chocolate" class="text-xs font-semibold uppercase tracking-widest hover:underline" style="color: #BE8D5A;">Nutrition Facts →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Story -->
  <section class="py-16 px-4" style="background-color: #EAD7BF;">
    <div class="max-w-5xl mx-auto flex flex-col lg:flex-row items-center gap-12">
      <div class="lg:w-1/2 rounded-2xl overflow-hidden shadow-md">
        <img src="/images/gallery6.jpg" alt="About Dairy Velvet" loading="lazy" class="w-full h-80 object-cover" />
      </div>
      <div class="lg:w-1/2">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: #BE8D5A;">Our Story</p>
        <h2 class="dv-serif font-bold text-4xl leading-tight mb-6" style="color: #1A0E07;">A taste of home, shared with the world</h2>
        <p class="text-base leading-relaxed mb-4" style="color: #5C3A20;">
          We come from Eastern Europe, where this creamy chocolate-coated dairy treat - known as Syrok - is a childhood favorite. Wanting to share those memories, we started making it at home for our kids. Soon friends and their kids fell in love with it too.
        </p>
        <p class="text-base leading-relaxed" style="color: #5C3A20;">
          Over time, we refined the recipe to make it lighter, healthier, and more balanced, while keeping the same rich, indulgent taste we grew up with. By sourcing our dairy from local Pennsylvania farmers, we support our community and keep our ingredients fresh.
        </p>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="py-12 px-4" style="background-color: #F8F3EC;">
    <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-3 gap-3">
      <img src="/images/gallery1.jpg" alt="Dairy Velvet Chocolate and Vanilla bars in their wrappers" loading="lazy" class="w-full h-52 object-cover rounded-xl" />
      <img src="/images/gallery2.jpg" alt="Plate of Dairy Velvet bars with coffee on a kitchen table" loading="lazy" class="w-full h-52 object-cover rounded-xl" />
      <img src="/images/gallery3.jpg" alt="Dairy Velvet bar on a plate next to a cappuccino" loading="lazy" class="w-full h-52 object-cover rounded-xl" />
      <img src="/images/gallery4.jpg" alt="Sliced Dairy Velvet bars showing the creamy farmer's cheese filling" loading="lazy" class="w-full h-52 object-cover rounded-xl" />
      <img src="/images/gallery5.jpg" alt="Mother and daughters enjoying Dairy Velvet bars with tea" loading="lazy" class="w-full h-52 object-cover rounded-xl" />
      <img src="/images/hero.jpg" alt="Vanilla and chocolate Dairy Velvet bars on a plate" loading="lazy" class="w-full h-52 object-cover rounded-xl" />
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-14 px-4 text-center" style="background-color: #EAD7BF;">
    <p class="text-xs font-semibold uppercase tracking-widest mb-2" style="color: #BE8D5A;">Get in Touch</p>
    <h2 class="dv-serif font-bold text-3xl mb-8" style="color: #1A0E07;">Contact Dairy Velvet</h2>
    <div class="space-y-2 text-base" style="color: #5C3A20;">
      <p><a href="mailto:team@dairyvelvet.com" class="hover:underline" style="color: #3E1D0D;">team@dairyvelvet.com</a></p>
      <p><a href="tel:+12672198251" class="hover:underline" style="color: #3E1D0D;">(267) 219-8251</a></p>
      <p>Lansdale, PA</p>
    </div>
    <div class="flex items-center justify-center gap-4 mt-6">
      <a target="_blank" href="https://www.facebook.com/profile.php?id=61580376261342" aria-label="Facebook" class="opacity-60 hover:opacity-100 transition-opacity">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="#3E1D0D"><path d="M22 12c0-5.522-4.477-10-10-10S2 6.478 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987H7.898v-2.89h2.54V9.797c0-2.507 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562v1.875h2.773l-.443 2.89h-2.33v6.987C18.343 21.128 22 16.991 22 12z"/></svg>
      </a>
      <a target="_blank" href="https://www.instagram.com/dairy_velvet/" aria-label="Instagram" class="opacity-60 hover:opacity-100 transition-opacity">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="#3E1D0D"><path d="M7 2C4.2 2 2 4.2 2 7v10c0 2.8 2.2 5 5 5h10c2.8 0 5-2.2 5-5V7c0-2.8-2.2-5-5-5H7zm10 2c1.7 0 3 1.3 3 3v10c0 1.7-1.3 3-3 3H7c-1.7 0-3-1.3-3-3V7c0-1.7 1.3-3 3-3h10zM12 7a5 5 0 100 10 5 5 0 000-10zm0 2a3 3 0 110 6 3 3 0 010-6zm4.8-3a1.2 1.2 0 11-2.4 0 1.2 1.2 0 012.4 0z"/></svg>
      </a>
    </div>
  </section>
</LayoutNew>
