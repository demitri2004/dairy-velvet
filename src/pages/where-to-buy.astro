---
import LayoutNew from '../layouts/LayoutNew.astro';

// Past dates, empty months and finished markets are hidden in the browser (see script below),
// so the page stays current between deploys.
const YEAR = 2026;

const markets = [
  {
    name: 'Lansdale Farmers Market',
    day: 'Every Saturday',
    hours: '9:00 AM – 12:30 PM',
    address: '400 Penn St, Lansdale, PA',
    mapUrl: 'https://www.google.com/maps/search/?api=1&query=Lansdale+Farmers+Market+400+Penn+St+Lansdale+PA',
    schedule: [
      { month: 'June', dates: [6, 13, 20, 27] },
      { month: 'July', dates: [4, 11, 18] },
      { month: 'August', dates: [1, 8, 15, 22, 29] },
      { month: 'September', dates: [5, 12, 19, 26] },
      { month: 'October', dates: [3, 10, 17, 24, 31] },
      { month: 'November', dates: [7, 14, 21] },
      { month: 'December', dates: [19] },
    ],
  },
  {
    name: 'North Wales Farmers Market',
    day: 'Select Sundays',
    schedule: [
      { month: 'June', dates: [7, 21] },
      { month: 'July', dates: [5] },
      { month: 'September', dates: [6, 20] },
      { month: 'October', dates: [4, 18] },
    ],
  },
  {
    name: 'Horsham Farmers Market',
    day: 'Select Sundays',
    schedule: [
      { month: 'June', dates: [14, 28] },
      { month: 'July', dates: [12, 19] },
      { month: 'August', dates: [30] },
      { month: 'September', dates: [13] },
      { month: 'October', dates: [11, 25] },
    ],
  },
];

const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const isoDate = (month: string, day: number) =>
  `${YEAR}-${String(MONTHS.indexOf(month) + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
---

<LayoutNew
  title="Where to Buy Dairy Velvet | Markets & Local Delivery"
  description="Find Dairy Velvet at Lansdale-area farmers markets and Organnons Natural Market in Newtown, PA, or order for market pickup and local delivery."
>
  <!-- Page header -->
  <section class="py-16 px-4 text-center" style="background-color: #EAD7BF;">
    <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: #BE8D5A;">Find Us Near You</p>
    <h1 class="dv-serif font-bold text-5xl" style="color: #1A0E07;">Where to Buy</h1>
    <a
      id="next-market"
      href="#markets"
      hidden
      class="inline-block mt-6 text-sm font-medium px-5 py-2 rounded-full hover:opacity-80 transition-opacity"
      style="background-color: #3d2314; color: #fdfaf6;"></a>
  </section>

  <!-- Intro -->
  <section class="py-16 px-4" style="background-color: #F8F3EC;">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-base leading-relaxed" style="color: #5C3A20;">
        Pre-order chocolate-coated farmer's cheese bars for pickup at Lansdale-area farmers markets,
        year-round at Organnons Natural Market in Newtown, or delivered straight to your door. Dairy
        Velvet makes creamy, syrok-style Eastern European cheesecake bars in small batches with
        local PA dairy, in dulce de leche, vanilla, and chocolate flavors.
      </p>
    </div>
  </section>

  <!-- In-store -->
  <section class="py-16 px-4" style="background-color: #EAD7BF;">
    <div class="max-w-5xl mx-auto flex flex-col lg:flex-row items-center gap-12">
      <div class="w-full lg:w-1/2 rounded-2xl overflow-hidden shadow-md">
        <img src="/images/organonns.jpg" alt="Dairy Velvet on the shelf at Organnons Natural Market" class="w-full h-80 object-cover" />
      </div>
      <div class="w-full lg:w-1/2">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: #BE8D5A;">In Store · Year-Round</p>
        <h2 class="dv-serif font-bold text-4xl leading-tight mb-6" style="color: #1A0E07;">Organnons Natural Market</h2>
        <p class="text-base leading-relaxed mb-4" style="color: #5C3A20;">Find us in the dairy section, available year-round.</p>
        <a href="https://maps.app.goo.gl/59mewJAKieUNnmc18" target="_blank" class="text-sm font-medium hover:underline" style="color: #BE8D5A;">Newtown, PA ↗</a>
      </div>
    </div>
  </section>

  <!-- Online Order & Delivery -->
  <section class="py-16 px-4" style="background-color: #F8F3EC;">
    <div class="max-w-5xl mx-auto flex flex-col lg:flex-row-reverse items-center gap-12">
      <div class="w-full lg:w-1/2 rounded-2xl overflow-hidden shadow-md">
        <img src="/images/products-stacked.jpg" alt="Dairy Velvet products for delivery" loading="lazy" class="w-full h-80 object-cover" />
      </div>
      <div class="w-full lg:w-1/2">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: #BE8D5A;">Order Online</p>
        <h2 class="dv-serif font-bold text-4xl leading-tight mb-6" style="color: #1A0E07;">Local Delivery & Pickup</h2>
        <p class="text-base leading-relaxed mb-4" style="color: #5C3A20;">
          Order anytime. We deliver twice a week! Place your order by 12 PM on Tuesday or Thursday for delivery that evening (6:30–8:30 PM) within 10 miles of Lansdale. Orders placed after the cutoff will be delivered on the next scheduled day.
        </p>
        <p class="text-base leading-relaxed mb-4" style="color: #5C3A20;">
          We'll text you when we're on our way. Questions? DM <a href="https://www.instagram.com/dairy_velvet/" target="_blank" class="hover:underline" style="color: #BE8D5A;">@dairy_velvet</a> or email <a href="mailto:team@dairyvelvet.com" class="hover:underline" style="color: #BE8D5A;">team@dairyvelvet.com</a>.
        </p>
        <p class="text-base leading-relaxed mb-8" style="color: #5C3A20;">
          Prefer to pick up? Order by Friday and pick up your order fresh at Saturday's Lansdale Farmers Market.
        </p>
        <a href="https://dairyvelvet.square.site" target="_blank" class="inline-block text-sm font-semibold px-6 py-3 rounded-full transition-opacity hover:opacity-80" style="background-color: #3d2314; color: #fdfaf6;">Order Now ↗</a>
      </div>
    </div>
  </section>

  <!-- Farmers Markets -->
  <section id="markets" class="py-16 px-4 scroll-mt-32" style="background-color: #F8F3EC;">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest mb-2" style="color: #BE8D5A;">Seasonal · 2026</p>
        <h2 class="dv-serif font-bold text-3xl" style="color: #1A0E07;">Farmers Markets</h2>
      </div>

      <div id="off-season" hidden class="max-w-2xl mx-auto mb-10 bg-white rounded-2xl p-6 text-center shadow-sm" style="border: 1px solid #D4BFA0;">
        <h3 class="dv-serif font-semibold text-xl mb-2" style="color: #1A0E07;">Off-season</h3>
        <p class="text-sm leading-relaxed" style="color: #5C3A20;">
          Our outdoor market season has wrapped up. Order online for local delivery, or find us year-round at
          Organnons Natural Market in Newtown. Winter market dates are coming soon.
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-6">
        {markets.map((market) => (
          <div class="market w-full md:w-[calc((100%-3rem)/3)] bg-white rounded-2xl p-6 shadow-sm" style="border: 1px solid #D4BFA0;" data-name={market.name} data-hours={market.hours}>
            <p class="text-xs font-semibold uppercase tracking-widest mb-2" style="color: #BE8D5A;">{market.day}</p>
            <h3 class="dv-serif font-semibold text-xl mb-2" style="color: #1A0E07;">{market.name}</h3>
            {market.hours && <p class="text-sm" style="color: #5C3A20;">{market.hours}</p>}
            {market.address && (
              <a href={market.mapUrl} target="_blank" class="text-sm font-medium hover:underline" style="color: #BE8D5A;">{market.address} ↗</a>
            )}

            <div class="space-y-3 mt-5">
              {market.schedule.map((entry) => (
                <div class="market-month">
                  <p class="text-xs font-semibold uppercase tracking-wide mb-0.5" style="color: #1A0E07;">{entry.month}</p>
                  <p class="text-sm" style="color: #5C3A20;">
                    {entry.dates.map((day, i) => (
                      <span class="market-date" data-date={isoDate(entry.month, day)}>{i > 0 && ', '}{day}</span>
                    ))}
                  </p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      <script is:inline>
        (function () {
          var d = new Date();
          var today = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
          var next = null;
          document.querySelectorAll('.market').forEach(function (market) {
            market.querySelectorAll('.market-month').forEach(function (month) {
              var upcoming = Array.prototype.filter.call(month.querySelectorAll('.market-date'), function (el) {
                if (el.dataset.date < today) { el.remove(); return false; }
                if (!next || el.dataset.date < next.date) {
                  next = { date: el.dataset.date, name: market.dataset.name, hours: market.dataset.hours };
                }
                return true;
              });
              if (!upcoming.length) month.remove();
              else upcoming[0].textContent = upcoming[0].textContent.replace(/^, /, '');
            });
            if (!market.querySelector('.market-date')) market.remove();
          });

          if (next) {
            var parts = next.date.split('-');
            var when = new Date(+parts[0], parts[1] - 1, +parts[2]);
            var label = next.date === today
              ? 'Today'
              : when.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
            var link = document.getElementById('next-market');
            link.textContent = 'Next market: ' + label + ' · ' + next.name + (next.hours ? ' · ' + next.hours : '');
            link.hidden = false;
          } else {
            document.getElementById('off-season').hidden = false;
          }
        })();
      </script>
      <div class="mt-10 rounded-2xl overflow-hidden shadow-md">
        <img src="/images/market-booth.jpg" alt="Dairy Velvet at the farmers market" loading="lazy" class="w-full" />
      </div>
    </div>
  </section>
</LayoutNew>
