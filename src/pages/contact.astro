---
import LayoutNew from '../layouts/LayoutNew.astro';
---

<LayoutNew title="Contact - Dairy Velvet">
  <!-- Page header -->
  <section class="py-16 px-4 text-center" style="background-color: #EAD7BF;">
    <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: #BE8D5A;">We'd Love to Hear From You</p>
    <h1 class="dv-serif font-bold text-5xl" style="color: #1A0E07;">Contact Us</h1>
  </section>

  <!-- Contact details -->
  <section class="py-20 px-4" style="background-color: #F8F3EC;">
    <div class="max-w-4xl mx-auto flex flex-col lg:flex-row gap-16">
      <!-- Left: info -->
      <div class="lg:w-1/2">
        <p class="text-xs font-semibold uppercase tracking-widest mb-6" style="color: #BE8D5A;">Get in Touch</p>
        <h2 class="dv-serif font-bold text-3xl leading-tight mb-8" style="color: #1A0E07;">Reach out with any questions about our products</h2>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-9 h-9 rounded-full flex items-center justify-center shrink-0 mt-0.5" style="background-color: #EAD7BF;">
              <svg class="w-4 h-4" fill="none" stroke="#BE8D5A" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest mb-1" style="color: #BE8D5A;">Email</p>
              <a href="mailto:team@dairyvelvet.com" class="text-base hover:underline" style="color: #3E1D0D;">team@dairyvelvet.com</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-9 h-9 rounded-full flex items-center justify-center shrink-0 mt-0.5" style="background-color: #EAD7BF;">
              <svg class="w-4 h-4" fill="none" stroke="#BE8D5A" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest mb-1" style="color: #BE8D5A;">Phone</p>
              <a href="tel:+12672198251" class="text-base hover:underline" style="color: #3E1D0D;">(267) 219-8251</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-9 h-9 rounded-full flex items-center justify-center shrink-0 mt-0.5" style="background-color: #EAD7BF;">
              <svg class="w-4 h-4" fill="none" stroke="#BE8D5A" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest mb-1" style="color: #BE8D5A;">Location</p>
              <p class="text-base" style="color: #3E1D0D;">Lansdale, PA</p>
            </div>
          </div>
        </div>

        <!-- Social icons -->
        <div class="mt-10">
          <p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color: #BE8D5A;">Follow Us</p>
          <div class="flex items-center gap-4">
            <a target="_blank" href="https://www.facebook.com/profile.php?id=61580376261342" aria-label="Facebook" class="opacity-60 hover:opacity-100 transition-opacity">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="#3E1D0D">
                <path d="M22 12c0-5.522-4.477-10-10-10S2 6.478 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987H7.898v-2.89h2.54V9.797c0-2.507 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562v1.875h2.773l-.443 2.89h-2.33v6.987C18.343 21.128 22 16.991 22 12z"/>
              </svg>
            </a>
            <a target="_blank" href="https://www.instagram.com/dairy_velvet/" aria-label="Instagram" class="opacity-60 hover:opacity-100 transition-opacity">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="#3E1D0D">
                <path d="M7 2C4.2 2 2 4.2 2 7v10c0 2.8 2.2 5 5 5h10c2.8 0 5-2.2 5-5V7c0-2.8-2.2-5-5-5H7zm10 2c1.7 0 3 1.3 3 3v10c0 1.7-1.3 3-3 3H7c-1.7 0-3-1.3-3-3V7c0-1.7 1.3-3 3-3h10zM12 7a5 5 0 100 10 5 5 0 000-10zm0 2a3 3 0 110 6 3 3 0 010-6zm4.8-3a1.2 1.2 0 11-2.4 0 1.2 1.2 0 012.4 0z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Right: image -->
      <div class="lg:w-1/2 rounded-2xl overflow-hidden shadow-md self-start">
        <img src="/images/gallery4.jpg" alt="Dairy Velvet" class="w-full h-96 object-cover" />
      </div>
    </div>
  </section>
</LayoutNew>
