---
import LayoutNew from '../layouts/LayoutNew.astro';
---

<LayoutNew title="Products - Dairy Velvet">
  <!-- Page header -->
  <section class="py-16 px-4 text-center" style="background-color: #EAD7BF;">
    <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: #BE8D5A;">What We Make</p>
    <h1 class="dv-serif font-bold text-5xl" style="color: #1A0E07;">Our Products</h1>
  </section>

  <!-- Product story -->
  <section class="py-16 px-4" style="background-color: #F8F3EC;">
    <div class="max-w-5xl mx-auto flex flex-col lg:flex-row items-center gap-12">
      <div class="lg:w-1/2">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: #BE8D5A;">Our Product</p>
        <h2 class="dv-serif font-bold text-4xl leading-tight mb-6" style="color: #1A0E07;">Inspired by tradition,<br/>made for today</h2>
        <p class="text-base leading-relaxed mb-4" style="color: #5C3A20;">
          Dairy Velvet is a creamy farmer's cheese center wrapped in a delicate layer of silky chocolate. High in protein, low in sugar, and made with simple, wholesome ingredients, it's the perfect balance of indulgence and nourishment.
        </p>
        <p class="text-base leading-relaxed" style="color: #5C3A20;">
          Inspired by the beloved Eastern European treat Syrok, we've refined the recipe for today - a snack that kids adore, adults crave, and everyone can feel good about enjoying. By sourcing our dairy from local farmers, we also support our community while bringing you the freshest, most honest ingredients.
        </p>
      </div>
      <div class="lg:w-1/2 rounded-2xl overflow-hidden shadow-md">
        <img src="/images/product-cut.jpg" alt="Dairy Velvet" class="w-full h-80 object-cover" />
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-16 px-4" style="background-color: #EAD7BF;">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="bg-white rounded-2xl p-8 shadow-sm" style="border: 1px solid #D4BFA0;">
        <div class="w-10 h-10 rounded-full flex items-center justify-center mb-5" style="background-color: #EAD7BF;">
          <svg class="w-5 h-5" fill="none" stroke="#BE8D5A" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
        </div>
        <h3 class="dv-serif font-semibold text-lg mb-2" style="color: #1A0E07;">Wholesome Ingredients</h3>
        <p class="text-sm leading-relaxed" style="color: #5C3A20;">Made only with fresh dairy and honest ingredients you can trust.</p>
      </div>
      <div class="bg-white rounded-2xl p-8 shadow-sm" style="border: 1px solid #D4BFA0;">
        <div class="w-10 h-10 rounded-full flex items-center justify-center mb-5" style="background-color: #EAD7BF;">
          <svg class="w-5 h-5" fill="none" stroke="#BE8D5A" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <h3 class="dv-serif font-semibold text-lg mb-2" style="color: #1A0E07;">Powerful Nutrition</h3>
        <p class="text-sm leading-relaxed" style="color: #5C3A20;">A snack that fuels your day without weighing you down.</p>
      </div>
      <div class="bg-white rounded-2xl p-8 shadow-sm" style="border: 1px solid #D4BFA0;">
        <div class="w-10 h-10 rounded-full flex items-center justify-center mb-5" style="background-color: #EAD7BF;">
          <svg class="w-5 h-5" fill="none" stroke="#BE8D5A" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
          </svg>
        </div>
        <h3 class="dv-serif font-semibold text-lg mb-2" style="color: #1A0E07;">High Protein</h3>
        <p class="text-sm leading-relaxed" style="color: #5C3A20;">Keeps you satisfied and energized with every creamy bite.</p>
      </div>
    </div>
  </section>

  <!-- Flavors -->
  <section class="py-16 px-4" style="background-color: #F8F3EC;">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest mb-2" style="color: #BE8D5A;">Our Flavors</p>
        <h2 class="dv-serif font-bold text-3xl" style="color: #1A0E07;">Choose Your Favorite</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm" style="border: 1px solid #D4BFA0;">
          <img src="/images/product_vanilla.png" alt="Vanilla" class="w-full h-64 object-cover" />
          <div class="p-6">
            <h3 class="dv-serif font-semibold text-xl mb-2" style="color: #1A0E07;">Vanilla</h3>
            <p class="text-sm leading-relaxed" style="color: #5C3A20;">Classic creamy vanilla farmer's cheese wrapped in a delicate layer of silky dark chocolate. Light, satisfying, and made with honest ingredients.</p>
          </div>
        </div>
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm" style="border: 1px solid #D4BFA0;">
          <img src="/images/product_chocolate.png" alt="Chocolate" class="w-full h-64 object-cover" />
          <div class="p-6">
            <h3 class="dv-serif font-semibold text-xl mb-2" style="color: #1A0E07;">Chocolate</h3>
            <p class="text-sm leading-relaxed" style="color: #5C3A20;">Rich chocolate farmer's cheese filling wrapped in a velvety chocolate coating. Deep flavor, high protein, and nothing artificial.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="py-12 px-4" style="background-color: #F8F3EC;">
    <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-3 gap-3">
      <img src="/images/gallery6.jpg" alt="" class="w-full h-52 object-cover rounded-xl" />
      <img src="/images/gallery3.jpg" alt="" class="w-full h-52 object-cover rounded-xl" />
      <img src="/images/gallery5.jpg" alt="" class="w-full h-52 object-cover rounded-xl" />
      <img src="/images/gallery2.jpg" alt="" class="w-full h-52 object-cover rounded-xl" />
      <img src="/images/gallery1.jpg" alt="" class="w-full h-52 object-cover rounded-xl" />
      <img src="/images/about-bars.jpg" alt="" class="w-full h-52 object-cover rounded-xl" />
    </div>
  </section>
</LayoutNew>
