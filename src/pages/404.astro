---
import LayoutNew from '../layouts/LayoutNew.astro';
---

<LayoutNew title="Page Not Found | Dairy Velvet" noindex>
  <section class="py-24 px-4 text-center" style="background-color: #EAD7BF;">
    <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: #BE8D5A;">404</p>
    <h1 class="dv-serif font-bold text-5xl mb-6" style="color: #1A0E07;">Page not found</h1>
    <p class="text-base leading-relaxed mx-auto mb-10" style="color: #5C3A20; max-width: 420px;">
      Sorry, we couldn't find that page. It may have moved, or the link may be out of date.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="inline-block text-sm font-semibold px-6 py-3 rounded-full transition-opacity hover:opacity-80" style="background-color: #3d2314; color: #fdfaf6;">Back to Home</a>
      <a href="https://dairyvelvet.square.site" target="_blank" class="inline-block text-sm font-semibold px-6 py-3 rounded-full transition-opacity hover:opacity-80" style="border: 1px solid #3d2314; color: #3d2314;">Order Now ↗</a>
    </div>
    <p class="mt-10 text-sm" style="color: #5C3A20;">
      Or visit <a href="/where-to-buy/" class="underline underline-offset-2" style="color: #3E1D0D;">Where to Buy</a>,
      <a href="/nutrition/" class="underline underline-offset-2" style="color: #3E1D0D;">Nutrition</a>, or
      <a href="/contact/" class="underline underline-offset-2" style="color: #3E1D0D;">Contact</a>.
    </p>
  </section>
</LayoutNew>
